# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/mailcheck?schema=public"

# The MAIL FROM / EHLO identity MailCheck presents during SMTP verification.
# Use a real domain you control that resolves — some receiving servers
# reject MAIL FROM addresses whose domain has no MX/A record.
EMAIL_VERIFICATION_FROM="postmaster@yourdomain.com"

# Per-connection SMTP timeout, in milliseconds.
SMTP_TIMEOUT_MS=10000

# DNS lookup timeout, in milliseconds.
DNS_TIMEOUT_MS=5000

# How many MX hosts (in priority order) to try before giving up.
SMTP_MAX_MX_ATTEMPTS=2

# How long a verification result is served from cache before a fresh SMTP
# check is triggered again for the same address.
VERIFICATION_CACHE_HOURS=24

# Requests allowed per minute per client IP on POST /api/verify-email.
RATE_LIMIT_PER_MINUTE=20

# Optional. If set, the app uses a Redis-backed rate limiter instead of the
# in-memory one (required once you run more than one instance/replica).
# See lib/rate-limit/rate-limiter.ts — RedisRateLimiter is a stub you must
# implement (e.g. with @upstash/redis) before setting this in production.
# RATE_LIMIT_REDIS_URL=
