// MailCheck — Prisma schema
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  deliverable
  undeliverable
  unknown
}

enum CheckStatus {
  pass
  fail
  unknown
}

enum MxStatus {
  found
  not_found
  unknown
}

enum SmtpConnectionStatus {
  success
  failed
  timeout
  skipped
}

enum SmtpRecipientStatus {
  accepted
  rejected
  unknown
}

model Verification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // The address exactly as submitted, and a normalized (trimmed, lowercase
  // domain) version used for de-duplication / cache lookups.
  email           String
  normalizedEmail String

  status VerificationStatus

  formatStatus CheckStatus
  domainStatus CheckStatus
  mxStatus     MxStatus

  smtpStatus  SmtpConnectionStatus
  smtpCode    Int?
  smtpMessage String?

  // Whether the recipient step itself was accepted/rejected — distinct from
  // the raw connection status above.
  smtpRecipientStatus SmtpRecipientStatus?

  // True when the mail server appears to accept-all recipients, meaning
  // mailbox existence could not be confidently confirmed even on a 2xx.
  catchAllSuspected Boolean @default(false)

  mxHost String?

  // Marks rows inserted by prisma/seed/seed.ts so the UI can badge them.
  isDemoData Boolean @default(false)

  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([normalizedEmail])
  @@index([status])
  @@index([createdAt])
}
